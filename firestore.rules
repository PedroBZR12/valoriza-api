rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isParticipant(chatData) {
      return request.auth != null &&
        (request.auth.uid == chatData.clientId ||
         request.auth.uid == chatData.companyId);
    }

    match /chats/{chatId} {
      allow read: if isParticipant(resource.data);
      allow write: if false;

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if isParticipant(parentChat());
        allow write: if false;
      }
    }
  }
}